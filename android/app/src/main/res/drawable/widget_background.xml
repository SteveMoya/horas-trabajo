<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget: gradiente vertical de la marca azul (Material 3)
     con esquinas grandes y continuas ("squircle"), coherente con las
     Cards de la app (ver PixelRadii en lib/core/theme/pixel_shapes.dart). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1A70C7"
        android:endColor="#0E4E9E" />
    <corners android:radius="24dp" />
</shape>