<?xml version="1.0" encoding="utf-8"?>
<!-- Widget MARCAR (1x1): un ÚNICO botón que llena el widget y alterna
     entrada/salida. Al ser un solo botón, cabe perfectamente en una celda de
     1x1 y también se ve bien en tamaños grandes (el botón se estira).
     El color/etiqueta del botón transmite el estado: blanco "Entrada" o
     rojo "Salida". Se usa el mismo id widget_boton_marcar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:id="@+id/marcador_container">

    <Button
        android:id="@+id/widget_boton_marcar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/widget_btn_marcar_entrada"
        android:textColor="#1565C0"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:gravity="center"
        android:text="Entrada" />
</FrameLayout>