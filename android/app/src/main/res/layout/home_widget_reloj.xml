<?xml version="1.0" encoding="utf-8"?>
<!-- Widget RELOJ: reloj en vivo (TextClock tiquea solo), la fecha y el estado
     de la jornada en un chip Material 3. Es informativo: tocar el widget
     abre la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:id="@+id/reloj_container">

    <TextView
        android:id="@+id/reloj_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HORAS TRABAJO · RELOJ"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <!-- Tarjeta central con el reloj en vivo. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_chip_bg">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false">

            <TextClock
                android:id="@+id/reloj_hora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="h:mm"
                android:textColor="#FFFFFF"
                android:textSize="46sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:includeFontPadding="false" />

            <TextClock
                android:id="@+id/reloj_segundos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="ss"
                android:format12Hour="ss"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:textColor="#66FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/reloj_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp"
            android:text="—" />
    </LinearLayout>

    <!-- Chip de estado de la jornada. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/widget_chip_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JORNADA"
            android:textColor="#99FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/reloj_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Fuera de la jornada" />
    </LinearLayout>
</LinearLayout>