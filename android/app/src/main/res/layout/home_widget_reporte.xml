<?xml version="1.0" encoding="utf-8"?>
<!-- Widget REPORTE: resumen rápido de horas de hoy y de la semana en chips
     Material 3. Es de solo lectura; tocar el widget abre la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:id="@+id/reporte_container">

    <TextView
        android:id="@+id/reporte_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HORAS TRABAJO · REPORTE"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/widget_chip_bg">

            <TextView
                android:id="@+id/reporte_hoy_valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="0.00 h" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#99FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:text="HOY" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/widget_chip_bg">

            <TextView
                android:id="@+id/reporte_semana_valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="0.00 h" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#99FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:text="ESTA SEMANA" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/reporte_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Fuera de la jornada" />
</LinearLayout>